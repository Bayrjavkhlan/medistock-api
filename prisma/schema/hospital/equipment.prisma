model Equipment {
  id       String  @id @default(uuid())
  name     String
  serialNo String  @unique
  brand    String?
  model    String?

  manufacturedYear Int?
  commissionedDate DateTime?
  endOfLifeDate    DateTime?

  passportDocument               String?
  usageManualDocument            String?
  calibrationInstructionDocument String?

  maintenancePlan String?

  requiredParts   String?
  usedParts       String?
  sparePartsStock String?

  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId String

  assignedTo   User?   @relation("AssignedEquipment", fields: [assignedToId], references: [id])
  assignedToId String?

  category EquipmentCategory
  state    EquipmentState

  logs EquipmentLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentLog {
  id String @id @default(uuid())

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String

  performedBy   User   @relation("PerformedLogs", fields: [performedById], references: [id])
  performedById String

  description  String
  type         EquipmentLogType @default(GENERAL)
  faultDate    DateTime?
  problem      String?
  repairAction String?
  status       String?

  createdAt DateTime @default(now())
}
