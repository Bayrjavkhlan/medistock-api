model Equipment {
  id       String  @id @default(uuid())
  name     String
  serialNo String  @unique
  brand    String?
  model    String?

  manufacturedYear Int?
  commissionedDate DateTime?
  endOfLifeDate    DateTime?

  passportDocument               String?
  usageManualDocument            String?
  calibrationInstructionDocument String?

  maintenancePlan String?

  requiredParts   String?
  usedParts       String?
  sparePartsStock String?

  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId String

  assignedTo   User?   @relation("AssignedEquipment", fields: [assignedToId], references: [id])
  assignedToId String?

  category EquipmentCategory
  state    EquipmentState

  logs             EquipmentLog[]
  imagingStudies   ImagingStudyImage[]
  analyticsReports AnalyticsReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentLog {
  id String @id @default(uuid())

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String

  performedBy   User   @relation("PerformedLogs", fields: [performedById], references: [id])
  performedById String

  description  String
  type         EquipmentLogType @default(GENERAL)
  faultDate    DateTime?
  problem      String?
  repairAction String?
  status       String?

  createdAt DateTime @default(now())
}

model ImagingStudyImage {
  id String @id @default(uuid())

  device   Equipment @relation(fields: [deviceId], references: [id])
  deviceId String

  imageId String @unique

  captureDateTime DateTime
  captureDate     String
  captureTime     String
  fileSizeBytes   Int
  studyType       String
  department      String
  patientCode     String

  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId String

  createdAt DateTime @default(now())

  @@index([deviceId, captureDateTime])
  @@index([hospitalId, captureDateTime])
}

model AnalyticsReport {
  id String @id @default(uuid())

  device   Equipment @relation(fields: [deviceId], references: [id])
  deviceId String

  period      String
  periodStart DateTime
  periodEnd   DateTime
  fileName    String
  pdfBase64   String

  createdAt DateTime @default(now())

  @@index([deviceId, period, createdAt])
}
